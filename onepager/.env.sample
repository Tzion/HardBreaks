# Copy to .env and fill in (never commit .env).
# Push to Netlify with: netlify env:import .env

# Cloudflare dashboard → R2 → overview page, "Account ID"
R2_ACCOUNT_ID=

# Shown once when you create the R2 API token (expires Dec 31, 2026)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket name, e.g. hardbreaks-stories
R2_BUCKET=

# Optional: ntfy topic for phone notifications, hard to guess, e.g. hardbreaks-stories-x7q2
NTFY_TOPIC=
