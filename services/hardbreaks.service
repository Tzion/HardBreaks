# place in  /etc/systemd/system/hardbreaks.service
[Unit]
Description=HardBreaks LED Matrix - run animation
After=network.target
# never give up restarting
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/HardBreaks
# For the audio player: pi's PipeWire, started by the desktop's automatic login, is reached through this directory
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/node /home/pi/HardBreaks/pi/run.js

# wait 10 seconds if crashes, then restart
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

