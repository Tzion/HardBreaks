# place in  /etc/systemd/system/bt-speaker.service
# Keeps a Bluetooth speaker connected; reconnects whenever it comes back on.
# If no known speaker connects for a while, it pairs any audio device placed right next to the Pi, so a
# speaker can be replaced in the field: switch the new one on and put it close to the Pi. See bt-speaker.sh.
# Settings (default speaker MAC etc.) are in services/bt-speaker.env.
#
# One-time setup, with the read-only overlay OFF (pairing is saved in /var/lib/bluetooth
# and would be lost on reboot otherwise):
#   1. Turn the speaker on, then: sudo bluetoothctl
#        scan on          (wait for the speaker's MAC, then: scan off)
#        pair <MAC>
#        trust <MAC>
#        connect <MAC>
#        quit
#   2. Put the MAC in SPEAKER_MAC in services/bt-speaker.env.
#   3. ./deploy.sh services   (from the Mac)
#   4. Check: journalctl -u bt-speaker -f   (should say "speaker connected")
#   5. Turn the speaker off and on and confirm it reconnects, then reboot the Pi and confirm again.

[Unit]
Description=HardBreaks - keep the Bluetooth speaker connected
After=bluetooth.service
Wants=bluetooth.service
# never give up restarting
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/bash /home/pi/HardBreaks/services/bt-speaker.sh

# wait 10 seconds if crashes, then restart
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
