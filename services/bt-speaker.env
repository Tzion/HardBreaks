# Settings for bt-speaker.sh, read every 10 s: editing this file on the Pi takes effect without a restart.
# Change it in the repo too, or the next deploy brings the old values back.

# The default speaker, always tried first. Changing it makes the Pi pair it if needed and switch to it.
SPEAKER_MAC=40:EF:4C:76:C1:E0
# Look for a new speaker after this many seconds without one
FALLBACK_AFTER_S=30
# Only pair new speakers this close: about -65 dBm is a few meters
MIN_RSSI=-65
